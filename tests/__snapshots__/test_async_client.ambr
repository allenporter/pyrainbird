# name: test_rainbird_client_only_passes_ssl_kwarg_when_configured
  list([
  ])
# ---
# name: test_request
  '''
  [client >]
  Payload: {
    "id": 1,
    "jsonrpc": "2.0",
    "method": "method",
    "params": {
      "key": "value"
    }
  }
  
  [server <]
  Payload: {
    "result": {
      "data": "result-data"
    }
  }
  '''
# ---
# name: test_request_failure
  '''
  [client >]
  Payload: {
    "id": 1,
    "jsonrpc": "2.0",
    "method": "example data",
    "params": 12
  }
  
  [error !]
  HTTP Status 500: Response had an error code
  '''
